{
  "$schema": "./cloudflare-engine/node_modules/wrangler/config-schema.json",
  // Root config mirrors the active World Engine Worker source.
  // Canonical deployment config remains in cloudflare-engine/wrangler.toml.
  "name": "neurolift-ai-fusion",
  "main": "./cloudflare-engine/src/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_ENGINE",
        "class_name": "WorldEngineDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorldEngineDO"
      ]
    }
  ]
}
