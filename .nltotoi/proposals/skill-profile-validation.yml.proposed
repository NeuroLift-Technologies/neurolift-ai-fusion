# PROPOSED VALIDATION WORKFLOW — NOT YET APPLIED
#
# Source: NeuroLift-Technologies/.github-private/.github/workflows/skill-profile-validation.yml
# Reason for staging: GitHub token lacks `workflows-write` scope.
#
# To apply:
#   git mv .nltotoi/proposals/skill-profile-validation.yml.proposed \
#          .github/workflows/skill-profile-validation.yml
#   git commit -m '[HUMAN] ci(skill-profile-validation): adopt NLT skill profile validation (ORG-DEV-OTOI-1.0.0)'
# ===================================================================

name: Skill Profile Validation

# Validates all skill profile files in skills/ and .claude/skills/ against
# NLT required frontmatter standards.
#
# SOP Reference: SOPs/repo-governance-setup.md — SOP-NLT-002
# Governed by: ORG-DEV-OTOI-1.0.0

on:
  push:
    branches: ["**"]
    paths:
      - "skills/**"
      - ".claude/skills/**"
  pull_request:
    branches: ["**"]
    paths:
      - "skills/**"
      - ".claude/skills/**"

jobs:
  validate-skill-profiles:
    name: Validate NLT Skill Profiles (ORG-DEV-OTOI-1.0.0)
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Validate skill profile frontmatter
        run: |
          #!/usr/bin/env bash
          set -euo pipefail

          REQUIRED_FIELDS=(name description nlt-otoi-version nlt-solidarity-framework nlt-haief nlt-authority)
          NLT_OTOI_VERSION="ORG-DEV-OTOI-1.0.0"
          NLT_SOLIDARITY="true"
          NLT_HAIEF="true"
          NLT_AUTHORITY="Joshua W. Dorsey, Sr."
          SKIP_FOLDERS=("example-skill")

          pass_count=0
          fail_count=0
          failures=()

          validate_skill_file() {
            local file="$1"
            local folder=$(basename "$(dirname "$file")")
            for skip in "${SKIP_FOLDERS[@]}"; do
              if [[ "$folder" == "$skip" ]]; then echo "  SKIPPED: $file"; return 0; fi
            done

            echo "  Validating: $file"
            local file_failures=()
            local frontmatter=$(awk '/^---$/{c++; if(c==1){p=1; next} if(c==2){p=0}} p{print}' "$file" 2>/dev/null || true)

            if [[ -z "$frontmatter" ]]; then
              file_failures+=("missing YAML frontmatter")
            else
              for field in "${REQUIRED_FIELDS[@]}"; do
                if ! echo "$frontmatter" | grep -qE "^${field}:"; then
                  file_failures+=("missing field: '${field}'")
                fi
              done

              local otoi_val=$(echo "$frontmatter" | grep -E "^nlt-otoi-version:" | sed 's/^nlt-otoi-version:[[:space:]]*//' | tr -d '"' || true)
              if [[ -n "$otoi_val" && "$otoi_val" != "$NLT_OTOI_VERSION" ]]; then
                file_failures+=("nlt-otoi-version must be '${NLT_OTOI_VERSION}', got: '${otoi_val}'")
              fi

              local authority_val=$(echo "$frontmatter" | grep -E "^nlt-authority:" | sed "s/^nlt-authority:[[:space:]]*//" | tr -d '"' || true)
              if [[ -n "$authority_val" && "$authority_val" != "$NLT_AUTHORITY" ]]; then
                file_failures+=("nlt-authority must be '${NLT_AUTHORITY}', got: '${authority_val}'")
              fi
            fi

            if [[ ${#file_failures[@]} -gt 0 ]]; then
              fail_count=$((fail_count + 1))
              failures+=("$file")
              for f in "${file_failures[@]}"; do echo "    FAIL: $f"; failures+=("  - $f"); done
            else
              pass_count=$((pass_count + 1))
              echo "    OK"
            fi
          }

          for dir in skills .claude/skills; do
            echo ""
            echo "=== Validating ${dir}/ ==="
            if [[ -d "$dir" ]]; then
              while IFS= read -r -d '' file; do
                validate_skill_file "$file"
              done < <(find "$dir" -name "SKILL.md" -print0 | sort -z)
            else
              echo "  ${dir}/ not found — skipping"
            fi
          done

          echo ""
          echo "=== Summary: ${pass_count} passed, ${fail_count} failed ==="
          if [[ $fail_count -gt 0 ]]; then
            echo ""
            for f in "${failures[@]}"; do echo "  - $f"; done
            exit 1
          fi
